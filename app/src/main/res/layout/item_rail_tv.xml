<?xml version="1.0" encoding="utf-8"?>
<!-- Fila del raíl de navegación de Android TV.

     focusable + clickable: con un mando, el foco ES el cursor. El estado focused
     lo pinta bg_rail_item (anillo blanco) y el selected, el bloque azul de la
     sección activa. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_rail_item"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/imgRailIcono"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@null"
        android:tint="@color/pelis_text"
        tools:src="@drawable/ic_live_tv" />

    <TextView
        android:id="@+id/txtRailTitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.Blabongo.Body"
        android:textColor="@color/pelis_text"
        tools:text="Canales en vivo" />

</LinearLayout>
